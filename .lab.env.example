# Copy to .lab.env and fill in if you create the personas through your own identity process.
# Application IDs of three service principals:
CLINICIAN_SP=00000000-0000-0000-0000-000000000000   # member of lab_clinicians
PII_READER_SP=00000000-0000-0000-0000-000000000000  # member of lab_pii_readers and lab_all_facilities
OUTSIDER_SP=00000000-0000-0000-0000-000000000000    # member of lab_outsiders
# Group names (account groups):
CLINICIANS_GROUP=lab_clinicians
PII_READERS_GROUP=lab_pii_readers
ALL_FACILITIES_GROUP=lab_all_facilities
OUTSIDERS_GROUP=lab_outsiders
LAB_PREFIX=lab
# Written by bootstrap_personas.sh: account IDs of identities it created (teardown.sh deletes only these).
# Leave empty if your identity team created the personas.
LAB_CREATED_SP_IDS=
LAB_CREATED_GROUP_IDS=
LAB_IDENTITY_TARGET=      # bundle target the identities were created for
LAB_IDENTITY_WORKSPACE_ID= # workspace they were created for
# Optional, enables teardown of the personas:
ACCOUNT_PROFILE=
WORKSPACE_ID=
