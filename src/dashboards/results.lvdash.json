{
  "datasets": [
    {
      "name": "latest",
      "displayName": "Latest suite run: result per test and persona (MISSING / PENDING when absent)",
      "queryLines": [
        "WITH suite AS (\n",
        "  SELECT run_id, mode, started_at FROM suite_runs ORDER BY started_at DESC LIMIT 1\n",
        "), expected_rows AS (\n",
        "  SELECT c.test_id, c.persona, c.layer, c.title, c.expected, c.source\n",
        "  FROM test_catalogue c CROSS JOIN suite s\n",
        "  WHERE array_contains(split(c.modes, ','), s.mode)\n",
        "), results AS (\n",
        "  SELECT r.* FROM test_results r JOIN suite s ON r.run_id = s.run_id\n",
        "  QUALIFY row_number() OVER (PARTITION BY r.test_id, r.persona ORDER BY r.ts DESC) = 1\n",
        "), merged AS (\n",
        "  SELECT coalesce(r.test_id, e.test_id) AS test_id, coalesce(r.persona, e.persona) AS persona,\n",
        "         coalesce(r.layer, e.layer) AS layer, coalesce(r.title, e.title) AS title,\n",
        "         coalesce(r.expected, e.expected) AS expected,\n",
        "         coalesce(r.status, CASE WHEN e.source = 'evidence' THEN 'PENDING' ELSE 'MISSING' END) AS status,\n",
        "         coalesce(r.observed, CASE WHEN e.source = 'evidence' THEN 'evidence job not run for this suite yet (lab_evidence, next day)'\n",
        "                                   ELSE 'no result in the latest suite run (job not run, or it failed before recording)' END) AS observed,\n",
        "         r.doc_url, r.ts, (SELECT run_id FROM suite) AS suite_run_id, (SELECT mode FROM suite) AS suite_mode\n",
        "  FROM expected_rows e FULL OUTER JOIN results r ON e.test_id = r.test_id AND e.persona = r.persona\n",
        ")\n",
        "SELECT test_id, layer,\n",
        "  CASE layer WHEN 1 THEN '1 Platform' WHEN 2 THEN '2 Data' WHEN 3 THEN '3 Models & Gateway' WHEN 4 THEN '4 Genie'\n",
        "             WHEN 5 THEN '5 Agents, MCP & Search' WHEN 6 THEN '6 Cost' WHEN 7 THEN '7 Audit' ELSE 'other' END AS layer_name,\n",
        "  CASE WHEN test_id IN ('D-06','D-07') THEN 'AI Functions'\n",
        "       ELSE CASE left(test_id, 1) WHEN 'A' THEN 'Genie' WHEN 'D' THEN 'Unity Catalog data' WHEN 'F' THEN 'AI Functions'\n",
        "            WHEN 'G' THEN 'Unity Gateway' WHEN 'B' THEN 'Who can build AI services' WHEN 'V' THEN 'Vector Search' WHEN 'T' THEN 'MCP & agent tools'\n",
        "            WHEN 'S' THEN 'Model serving & agents' WHEN 'X' THEN 'MLflow traces' WHEN 'R' THEN 'Agent Bricks'\n",
        "            WHEN 'P' THEN 'Platform' WHEN 'C' THEN 'Cost' WHEN 'O' THEN 'Audit' ELSE 'other' END END AS feature,\n",
        "  title, persona, status, expected, observed, doc_url, ts, suite_run_id, suite_mode\n",
        "FROM merged"
      ]
    }
  ],
  "pages": [
    {
      "name": "results",
      "displayName": "GenAI governance lab results",
      "layout": [
        {
          "widget": {
            "name": "title",
